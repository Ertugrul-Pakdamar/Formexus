# Server Configuration
PORT=8080
ENV=development

# MongoDB Configuration
# Local development: mongodb://localhost:27017/formexus
# Docker: mongodb://admin:password@mongodb:27017/formexus?authSource=admin
MONGODB_URI=mongodb://localhost:27017/formexus
MONGODB_DATABASE=formexus

# JWT Configuration
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h

# Frontend URL (for CORS)
# Development: http://localhost:5173 or http://localhost:3000
FRONTEND_URL=http://localhost:5173
