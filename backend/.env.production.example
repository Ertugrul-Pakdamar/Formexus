# Server Configuration
PORT=8080
ENV=production

# MongoDB Configuration
# Docker/Self-hosted: mongodb://admin:password@mongodb:27017/formexus?authSource=admin
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/formexus?retryWrites=true&w=majority
MONGODB_URI=mongodb://admin:your_strong_password@mongodb:27017/formexus?authSource=admin
MONGODB_DATABASE=formexus

# JWT Configuration
# IMPORTANT: Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE-THIS-TO-A-RANDOM-SECRET-MIN-32-CHARACTERS
JWT_EXPIRATION=24h

# Frontend URL (for CORS)
# Production domain (Cloudflare/Render/etc)
FRONTEND_URL=https://formexus.net
