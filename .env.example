# =================================
# MongoDB Configuration
# =================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_strong_password_here
MONGO_DATABASE=formexus

# MongoDB Connection URI
# For local Docker: mongodb://username:password@mongodb:27017
# For Atlas: mongodb+srv://username:password@cluster.mongodb.net/formexus
MONGODB_URI=mongodb://admin:your_strong_password_here@mongodb:27017

# =================================
# Backend Configuration
# =================================
PORT=8080
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_please_change_this

# Frontend URL (for CORS)
# Local: http://localhost:3000
# Production: https://formexus.net
FRONTEND_URL=https://formexus.net

# =================================
# Frontend Configuration
# =================================
# Backend API URL
# Local: http://localhost:8080
# Production: https://formexus.net/api
VITE_API_URL=https://formexus.net/api

# =================================
# Cloudflare Tunnel Configuration
# =================================
# Cloudflare Tunnel Token (Get from: dash.cloudflare.com > Traffic > Cloudflare Tunnel)
TUNNEL_TOKEN=your-tunnel-token-here

# =================================
# System Configuration
# =================================
# Docker compose project name
COMPOSE_PROJECT_NAME=formexus

# Timezone
TZ=Europe/Istanbul
