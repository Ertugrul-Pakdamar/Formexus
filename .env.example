# =================================
# MongoDB Configuration
# =================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_strong_password_here
MONGO_DATABASE=formexus

# MongoDB Connection URI
# For local Docker: mongodb://username:password@mongodb:27017
# For Atlas: mongodb+srv://username:password@cluster.mongodb.net/formexus
MONGODB_URI=mongodb://admin:your_strong_password_here@mongodb:27017

# =================================
# Backend Configuration
# =================================
PORT=8080
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_please_change_this

# Frontend URL (for CORS)
# Local: http://localhost:3000
# Production: https://formexus.yourdomain.com
FRONTEND_URL=http://localhost:3000

# =================================
# Frontend Configuration
# =================================
# Backend API URL
# Local: http://localhost:8080
# Production: https://api.formexus.yourdomain.com
VITE_API_URL=http://localhost:8080

# =================================
# Cloudflare Tunnel Configuration
# =================================
# Your Cloudflare Tunnel ID (get this after creating tunnel)
TUNNEL_ID=your-tunnel-id-here

# Your domain names
FRONTEND_DOMAIN=formexus.yourdomain.com
API_DOMAIN=api.formexus.yourdomain.com

# =================================
# System Configuration
# =================================
# Docker compose project name
COMPOSE_PROJECT_NAME=formexus

# Timezone
TZ=Europe/Istanbul
