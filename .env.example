# =================================
# MongoDB Configuration
# =================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_strong_password_here
MONGO_DATABASE=formexus

# MongoDB Connection URI (for backend)
# Docker: mongodb://admin:your_password@mongodb:27017/formexus?authSource=admin
# Local: mongodb://admin:your_password@localhost:27017/formexus?authSource=admin
MONGODB_URI=mongodb://admin:your_strong_password_here@mongodb:27017/formexus?authSource=admin

# =================================
# JWT Configuration
# =================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_please_change_this

# =================================
# URLs Configuration
# =================================
# Frontend URL (for CORS)
FRONTEND_URL=https://formexus.net

# Backend API URL (for frontend)
VITE_API_URL=https://formexus.net/api
